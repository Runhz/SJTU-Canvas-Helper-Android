{
  "productName": "Canvas 随行",
  "version": "0.8.9",
  "identifier": "com.canvas.suixing.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix demo run build:desktop",
    "frontendDist": "../demo/dist",
    "devUrl": "http://127.0.0.1:4174"
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "app": {
    "security": {
      "csp": "default-src 'self' http: https: data: blob: 'unsafe-eval' 'unsafe-inline'; connect-src 'self' http: https: ws: wss: wss://jaccount.sjtu.edu.cn"
    },
    "windows": [
      {
        "label": "main",
        "title": "Canvas 随行",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": false
      }
    ]
  }
}
