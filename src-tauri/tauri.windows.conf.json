{
  "productName": "Canvas 随行",
  "version": "1.0.0",
  "identifier": "com.canvas.suixing.windows",
  "build": {
    "features": ["windows-workspace"],
    "beforeBuildCommand": "npm --prefix windows-app run build",
    "frontendDist": "../windows-app/dist",
    "devUrl": "http://127.0.0.1:4175"
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false
  },
  "app": {
    "security": {
      "csp": "default-src 'self' http: https: data: blob: 'unsafe-eval' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Canvas 随行",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "maximized": true,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": false
      }
    ]
  }
}
